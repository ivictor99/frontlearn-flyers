# Copy to .env and edit. Nothing here is required — the app runs without it.

# --- Server ---------------------------------------------------------------
PORT=4010
HOST=0.0.0.0

# Where the JSON store and uploaded images live (defaults to ./data)
# DATA_DIR=./data

# --- Seeded accounts ------------------------------------------------------
# Change these before putting the app anywhere public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying
STAFF_PASSWORD=change-me-too

# Set to 1 only when serving over plain HTTP (e.g. behind a local proxy)
# INSECURE_COOKIES=1

# --- Optional AI assistance ----------------------------------------------
# Leave unset to use the built-in offline parser only.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
